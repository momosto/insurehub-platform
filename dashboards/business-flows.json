{
  "title": "InsureHub - business flows",
  "uid": "insurehub-business",
  "schemaVersion": 39,
  "tags": [
    "insurehub"
  ],
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "USSD sessions started / completed",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ussd_sessions_started_total[15m])) * 900",
          "legendFormat": "started per 15 min"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "USSD drop-off by node",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (ussd_node) (rate(ussd_node_views_total[1h]))",
          "legendFormat": "{{ussd_node}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "USSD backend fallbacks (cache or SMS)",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ussd_backend_fallbacks_total[15m]))",
          "legendFormat": "fallbacks"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "LendHub end-of-day duration",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(spring_batch_job_seconds_max{spring_batch_job_name=\"eodJob\"})",
          "legendFormat": "EOD"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "RabbitMQ dead-letter queues",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (queue) (rabbitmq_queue_messages{queue=~\".*\\.dlq\"})",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Payments callbacks into LendHub (2xx vs other)",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{service_name=\"lendhub-api\", http_route=\"/api/v1/integrations/payments\"}[15m]))",
          "legendFormat": "{{http_response_status_code}}"
        }
      ]
    }
  ]
}